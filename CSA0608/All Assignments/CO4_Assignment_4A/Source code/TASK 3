    knapsack(items, 7)

    print("\nTEST: Capacity 1")
    knapsack(items, 1)

    print("\nTEST: Capacity 14")
    knapsack(items, 14)

    print("\nTEST: Classic Instance")

    trap = [
        ("A", 10, 60),
        ("B", 20, 100),
        ("C", 30, 120)
    ]

    knapsack(trap, 50)
