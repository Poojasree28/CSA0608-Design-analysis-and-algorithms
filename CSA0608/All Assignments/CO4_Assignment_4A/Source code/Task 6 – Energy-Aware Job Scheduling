
import bisect
import itertools
import random


def schedule(jobs, verbose=True):
    jobs = sorted(jobs, key=lambda j: (j[2], j[1]))

    n = len(jobs)
    finishes = [j[2] for j in jobs]

    p = [0] * (n + 1)

    for i in range(1, n + 1):
        p[i] = bisect.bisect_right(
            finishes,
            jobs[i - 1][1],
            0,
            i - 1
        )

    OPT = [0] * (n + 1)
    take = [False] * (n + 1)

    if verbose:
        print("\nJob Details")
        print("Index Job Start Finish Value P(i)")

        for i in range(1, n + 1):
            name, start, finish, value = jobs[i - 1]
            print(i, name, start, finish, value, p[i])

    for i in range(1, n + 1):
        name, start, finish, value = jobs[i - 1]

        exclude = OPT[i - 1]
        include = value + OPT[p[i]]

        if include > exclude:
            OPT[i] = include
            take[i] = True
        else:
            OPT[i] = exclude
            take[i] = False

        if verbose:
            print(
                "OPT[", i, "]",
                "Exclude =", exclude,
                "Include =", include,
                "Result =", OPT[i]
            )

    selected = []
    i = n

    while i > 0:
        if take[i]:
            selected.append(jobs[i - 1][0])
            i = p[i]
        else:
            i -= 1

    selected.reverse()

    if verbose:
        print("OPT Array:", OPT)

    return OPT[n], selected


def brute_force(jobs):
    best = 0

    for r in range(len(jobs) + 1):
        for combo in itertools.combinations(jobs, r):

            valid = True

            for a, b in itertools.combinations(combo, 2):
                if not (a[2] <= b[1] or b[2] <= a[1]):
                    valid = False
                    break

            if valid:
                value = sum(job[3] for job in combo)
                best = max(best, value)

    return best


def greedy_generic(jobs, key):
    selected = []

    for job in sorted(jobs, key=key):
        if all(
            job[2] <= chosen[1] or chosen[2] <= job[1]
            for chosen in selected
        ):
            selected.append(job)

    return [j[0] for j in selected], sum(
        j[3] for j in selected
    )


