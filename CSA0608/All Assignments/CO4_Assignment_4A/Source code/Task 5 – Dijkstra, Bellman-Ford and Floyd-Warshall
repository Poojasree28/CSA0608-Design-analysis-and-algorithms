
import heapq

INF = float("inf")

V = ["A", "B", "C", "D", "E"]

EDGES = [
    ("A", "B", 4),
    ("A", "C", 7),
    ("B", "C", 2),
    ("B", "D", 6),
    ("C", "D", 1),
    ("D", "E", 3),
    ("C", "E", 8)
]


def path_to(pred, target):
    path = []

    while target is not None:
        path.append(target)
        target = pred[target]

    return " -> ".join(reversed(path))


# 5.1 DIJKSTRA ALGORITHM

def dijkstra(vertices, edges, source):
    adj = {v: [] for v in vertices}

    for u, v, w in edges:
        if w < 0:
            raise ValueError("Dijkstra requires non-negative weights")
        adj[u].append((v, w))

    dist = {v: INF for v in vertices}
    pred = {v: None for v in vertices}

    dist[source] = 0
    pq = [(0, source)]
    visited = set()

    while pq:
        d, u = heapq.heappop(pq)

        if u in visited:
            continue

        visited.add(u)

        for v, w in adj[u]:
            if v not in visited and dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                pred[v] = u
                heapq.heappush(pq, (dist[v], v))

    return dist, pred


# 5.2 BELLMAN-FORD ALGORITHM

def bellman_ford(vertices, edges, source):
    dist = {v: INF for v in vertices}
    pred = {v: None for v in vertices}

    dist[source] = 0

    for i in range(len(vertices) - 1):
        changed = False

        for u, v, w in edges:
            if dist[u] != INF and dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                pred[v] = u
                changed = True

        print("Pass", i + 1, ":", dist)

        if not changed:
            break

    for u, v, w in edges:
        if dist[u] != INF and dist[u] + w < dist[v]:
            return dist, pred, True

    return dist, pred, False


# 5.3 FLOYD-WARSHALL ALGORITHM

def floyd_warshall(vertices, edges):
    n = len(vertices)
    index = {v: i for i, v in enumerate(vertices)}

    D = [[INF] * n for _ in range(n)]

    for i in range(n):
        D[i][i] = 0

    for u, v, w in edges:
        D[index[u]][index[v]] = w

    for k in range(n):
        for i in range(n):
            for j in range(n):
                if D[i][k] + D[k][j] < D[i][j]:
                    D[i][j] = D[i][k] + D[k][j]

    return D


def show_matrix(D, vertices):
    print("     ", end="")

    for v in vertices:
        print("%8s" % v, end="")

    print()

    for i, v in enumerate(vertices):
        print("%5s" % v, end="")

        for value in D[i]:
            if value == INF:
                print("%8s" % "INF", end="")
            else:
                print("%8s" % value, end="")

        print()


