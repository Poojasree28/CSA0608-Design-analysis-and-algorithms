    ]

    d, p, neg = bellman_ford(V2, E_NEG, "A")

    print("Bellman-Ford Distances:", d)
    print("Negative Cycle:", neg)
    print("Correct Path to D:", path_to(p, "D"))

    print("\nNEGATIVE CYCLE TEST")

    E_CYCLE = [
        ("A", "B", 1),
        ("B", "C", -3),
