    ]

    d, p, neg = bellman_ford(V2, E_CYCLE, "A")

    print("Negative Cycle Detected:", neg)

    print("\nTASK 5.3: FLOYD-WARSHALL")

    D = floyd_warshall(V, EDGES)

    print("\nFinal All-Pairs Shortest Path Matrix")

    show_matrix(D, V)
