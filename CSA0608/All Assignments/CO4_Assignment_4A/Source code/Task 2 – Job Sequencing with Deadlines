
def job_sequencing(jobs):
    jobs_sorted = sorted(jobs, key=lambda x: -x[2])

    max_deadline = max(job[1] for job in jobs)
    slots = [None] * (max_deadline + 1)
    total_profit = 0

    print("Jobs sorted by profit:", jobs_sorted)
    print("\nScheduling jobs:")

    for job_id, deadline, profit in jobs_sorted:
        placed = False

        for slot in range(min(deadline, max_deadline), 0, -1):
            if slots[slot] is None:
                slots[slot] = job_id
                total_profit += profit
                placed = True
                print("Job", job_id, "placed in slot", slot)
                break

        if not placed:
            print("Job", job_id, "rejected")

    schedule = []

    for i in range(1, max_deadline + 1):
        if slots[i] is not None:
            schedule.append((i, slots[i]))

    print("\nFinal Schedule:", schedule)
    print("Total Profit:", total_profit)


